        <field>caller</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Auto Pupulate Caller Details </name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (!newValue) {
       g_form.clearValue('email');
       g_form.clearValue('department');
       return;
   }
   g_form.getReference('caller', function(user) {
       if (g_form.getValue('caller') !== newValue) {
           return;
       }
       g_form.setValue('email', user.email || '');
       if (user.department) {
           g_form.setValue('department', user.department.toString());
       } else {
           g_form.clearValue('department');
       }
   });
}]]></script>
